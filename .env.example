# Master key the webapp uses to talk to the LiteLLM admin API.
# Also the value Claude Code's wrapper sends as ANTHROPIC_AUTH_TOKEN.
# Generate something random and keep it to yourself - this stays local.
LITELLM_MASTER_KEY=sk-claudex-change-me

# Optional: pin the LiteLLM version. Pinned away from the compromised
# 1.82.7 and 1.82.8 releases (see Anthropic's LLM gateway docs).
LITELLM_VERSION=>=1.83.0,<2

# Optional: GitHub Enterprise Copilot endpoints. Leave commented for github.com.
# GITHUB_COPILOT_API_BASE=https://copilot-api.your-company.ghe.com
# GITHUB_COPILOT_DEVICE_CODE_URL=https://your-company.ghe.com/login/device/code
# GITHUB_COPILOT_ACCESS_TOKEN_URL=https://your-company.ghe.com/login/oauth/access_token
# GITHUB_COPILOT_API_KEY_URL=https://your-company.ghe.com/api/v3/copilot_internal/v2/token
